---
import { useTranslations, CONTACT_EMAIL, X_URL, X_HANDLE } from '../i18n/ui';
import type { Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<footer class="site-footer">
  <div class="container">
    <span>{t('footer.copyright')}</span>
    <span class="footer-sep" aria-hidden="true">&middot;</span>
    <a href={t('nav.products.kurippa.href')}>Kurippa</a>
    <span class="footer-sep" aria-hidden="true">&middot;</span>
    <a href={t('nav.products.vaultz.href')}>Vaultz</a>
    <span class="footer-sep" aria-hidden="true">&middot;</span>
    <a href={t('nav.blog.href')}>{t('nav.blog')}</a>
    <span class="footer-sep" aria-hidden="true">&middot;</span>
    <a href={t('nav.about.href')}>{t('nav.about')}</a>
    <span class="footer-sep" aria-hidden="true">&middot;</span>
    <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
    <span class="footer-sep" aria-hidden="true">&middot;</span>
    <a href={X_URL} target="_blank" rel="noopener noreferrer">{X_HANDLE}</a>
  </div>
</footer>
